# ── Backend selector ─────────────────────────────────────────────────────────
# Choose one: ollama | openai | anthropic
BACKEND=ollama

# ── Ollama (default) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI (or any OpenAI-compatible API) ────────────────────────────────────
# BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for Groq, Together, etc.

# ── Anthropic ─────────────────────────────────────────────────────────────────
# BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # rarely needs changing

# ── Shared ───────────────────────────────────────────────────────────────────
DB_PATH=metrics.db
METRICS_QUEUE_MAX_SIZE=1000
LOG_LEVEL=INFO

# ── Pricing ───────────────────────────────────────────────────────────────────
# Optional: path to a JSON file that overrides or extends built-in model prices.
# Copy prices.example.json → prices.json and edit to add custom/new models.
# PRICES_PATH=prices.json
